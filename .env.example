# Copy to .env for local use. Never commit the real .env file.
# In production set these as environment variables on the host (Railway, etc.).

# --- Database (MySQL 8) ---
DB_URL=jdbc:mysql://localhost:3306/tickethub?useSSL=false&allowPublicKeyRetrieval=true&rewriteBatchedStatements=true&serverTimezone=UTC
DB_USER=tickethub
DB_PASSWORD=change-me

# --- Security ---
# HS256 key, at least 32 bytes. Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-value-at-least-32-bytes

# HMAC secret shared with the payment gateway for webhook verification.
PAYMENT_WEBHOOK_SECRET=replace-with-gateway-webhook-secret

# --- Web ---
# Comma-separated list of frontend origins allowed by CORS. No trailing slash.
CORS_ORIGINS=http://localhost:5173

# --- Optional ---
# SERVER_PORT=8080
# SPRING_PROFILES_ACTIVE=demo     # seeds a demo catalogue and two well-known logins: never use in real production
# JAVA_OPTS=-Xmx512m
